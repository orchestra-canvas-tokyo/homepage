# Official Cloudflare Turnstile test keys. These always pass and must never be used in production.
DEPLOYMENT_ENV=local
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Use a non-production Resend API key/account while developing.
RESEND_API_KEY=

# Optional. Leave unset to disable Slack notifications.
SLACK_WEBHOOK_URL=
